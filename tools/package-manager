#!/usr/bin/env bash

cd "$(dirname $0)"

command=pikaur
storage_path="../storage/${command}"
if ! command -v ${command} &>/dev/null; then
    sudo pacman -Syu --noconfirm
    sudo pacman -S --needed --noconfirm base-devel git

    if [ -d $storage_path ]; then
        rm -rf $storage_path
    fi
    git clone https://aur.archlinux.org/${command}.git $storage_path
    cd $storage_path
    makepkg -fsri --noconfirm
fi

export package_manager=${command}